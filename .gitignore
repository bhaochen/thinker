# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env

# Scratch space (notebooks, screenshots)
tmp/

# ---------------------------------------------------------------------------
# LaTeX: intermediate build files (regenerated by latexmk/pdflatex + bibtex)
# ---------------------------------------------------------------------------
*.aux
*.bcf
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ind
*.ilg
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.spl
*.synctex.gz
*.toc
*.vrb

# ---------------------------------------------------------------------------
# LaTeX: final build output
# ---------------------------------------------------------------------------
*.pdf
*.ps
*.dvi
*.html
*.htm

# ...but the paper's source figures ARE pdfs, so keep them tracked.
!docs/images/*.pdf

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
*~
*.swp
.DS_Store
